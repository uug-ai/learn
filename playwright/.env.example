# Base URL of the Hub frontend (no trailing slash).
HUB_BASE_URL=http://localhost:4200

# Credentials for the uugai account. HUB_USERNAME may be its login email;
# the signed-in Hub username must be exactly uugai.
HUB_USERNAME=
HUB_PASSWORD=

# Optional: where to write the captured screenshots.
# Defaults to ../app/content/docs/hub/cases (relative to this folder).
# SCREENSHOT_DIR=../app/content/docs/hub/cases
