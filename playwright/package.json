    "media:headed": "playwright test tests/media.spec.ts --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.4.0"
  }
}
