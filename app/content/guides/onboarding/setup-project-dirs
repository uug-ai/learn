#!/bin/zsh

# Example usage:
# Place your own local `private.gpg` and `github_rsa` files next to this script.
# These key files are intentionally gitignored and must not be committed.
# ./setup-project-dirs            # Uses all defaults
# ./setup-project-dirs private.gpg github_rsa "John Doe" "john@example.com"

# Change below variables as needed
# Set defaults
GPG_PRIVATE_KEY_FILE="${1:-private.gpg}"
SSH_PRIVATE_KEY_FILE="${2:-github_rsa}"
GIT_USERNAME="${3:-Your Name}"
GIT_EMAIL="${4:-yourname@uug.ai}"


# Check if private.gpg and github_rsa files exist in the current directory
if [ ! -f "$GPG_PRIVATE_KEY_FILE" ]; then
    echo "✗ GPG private key file '$GPG_PRIVATE_KEY_FILE' not found in the current directory."
    exit 1
fi
if [ ! -f "$SSH_PRIVATE_KEY_FILE" ]; then
    echo "✗ SSH private key file '$SSH_PRIVATE_KEY_FILE' not found in the current directory."
    exit 1
fi

# Add GPG keys
gpg --list-secret-keys --keyid-format LONG > /dev/null 2>&1
if [ $? -ne 0 ]; then
    echo "✗ No GPG keys found. Please generate a GPG key before proceeding."
fi
# Import GPG key if it doesn't already exist
if ! gpg --list-secret-keys --keyid-format LONG | grep -q .; then
    if [ -f "$GPG_PRIVATE_KEY_FILE" ]; then
        gpg --import "$GPG_PRIVATE_KEY_FILE"
    else
        echo "✗ GPG private key file '$GPG_PRIVATE_KEY_FILE' not found."
    fi
fi
# Extract the key ID of the imported key
KEY_ID=$(gpg --list-secret-keys --keyid-format LONG | grep sec | awk '{print $2}' | cut -d'/' -f2 | head -n 1)

# Check if key was already configured
if git config --global user.signingkey &>/dev/null; then
    echo "✓ GPG key already configured for Git signing."
else
    # Configure Git to use the GPG key for signing commits
    git config --global user.signingkey $KEY_ID
    git config --global commit.gpgsign true
    echo "pinentry-program /usr/local/bin/pinentry-mac" >> ~/.gnupg/gpg-agent.conf
    echo "✓ Git configured to use GPG key for signing commits."
fi

# Initialize git with username and email if not already set
if ! git config --global user.name &>/dev/null; then
    git config --global user.name "$GIT_USERNAME"
    echo "✓ Git global username set."
else
    echo "✓ Git global username already set, skipping."
fi
if ! git config --global user.email &>/dev/null; then
    git config --global user.email "$GIT_EMAIL"
    echo "✓ Git global email set."
else
    echo "✓ Git global email already set, skipping."
fi

# Add SSH keys
if [ ! -f "$SSH_PRIVATE_KEY_FILE" ]; then
    echo "✗ SSH private key file '$SSH_PRIVATE_KEY_FILE' not found. Please provide the SSH key before proceeding."
fi
mkdir -p ~/.ssh
if [ ! -f ~/.ssh/"$SSH_PRIVATE_KEY_FILE" ]; then
    cp "$SSH_PRIVATE_KEY_FILE" ~/.ssh/"$SSH_PRIVATE_KEY_FILE"
    chmod 600 ~/.ssh/"$SSH_PRIVATE_KEY_FILE"
    # Use -K flag to persist key in macOS Keychain across reboots
    ssh-add -K ~/.ssh/"$SSH_PRIVATE_KEY_FILE" 2>/dev/null || ssh-add --apple-use-keychain ~/.ssh/"$SSH_PRIVATE_KEY_FILE"
    echo "✓ SSH key added to Keychain for persistence across reboots."
else
    echo "✓ SSH key already exists, skipping."
fi

# Configure SSH config to use Keychain
if [ ! -f ~/.ssh/config ]; then
    cat > ~/.ssh/config << 'EOF'
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/"$SSH_PRIVATE_KEY_FILE"
    UseKeychain yes
    AddKeysToAgent yes
EOF
    chmod 600 ~/.ssh/config
    echo "✓ SSH config created with Keychain integration."
else
    if ! grep -q "UseKeychain yes" ~/.ssh/config; then
        echo "Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/"$SSH_PRIVATE_KEY_FILE"
    UseKeychain yes
    AddKeysToAgent yes" >> ~/.ssh/config
        echo "✓ GitHub SSH config added to existing config."
    fi
fi
if ! grep -q "github.com" ~/.ssh/known_hosts 2>/dev/null; then
    ssh-keyscan github.com >> ~/.ssh/known_hosts
    echo "✓ GitHub host key added to known_hosts."
else
    echo "✓ GitHub host key already in known_hosts, skipping."
fi

# Setup base project directories
mkdir -p ~/Projects/github.com/uug-ai
echo "✓ Created folder structure at ~/Projects/github.com/uug-ai/"

# Clone essential repositories
cd ~/Projects/github.com/uug-ai
repos=(
    "models"
    "hub-frontend"
    "hub-api"
    "hub-pipeline"
    "hub-pipeline-event"
    "hub-pipeline-monitor"
    "hub-pipeline-sequence"
    "hub-pipeline-thumbnail"
    "hub-pipeline-notification"
    "hub-pipeline-notification-test"
    "learn"
    "gitops"
)
for repo in "${repos[@]}"; do
    if [ -d "$repo" ]; then
        echo "✓ Repository '$repo' already exists, skipping clone."
    else
        git clone git@github.com:uug-ai/$repo.git 2>/dev/null
        if [ $? -eq 0 ]; then
            echo "✓ Successfully cloned '$repo'."
        else
            echo "✗ Failed to clone '$repo'. Check your SSH key and GitHub access."
        fi
    fi
done
