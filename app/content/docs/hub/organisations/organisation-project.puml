@startuml
title Organisation and project domain models
top to bottom direction
skinparam classAttributeIconSize 0
skinparam shadowing false
hide methods
namespace models {
    class "User" << (S,Aquamarine) >> {
        + Id primitive.ObjectID
        + OrganisationId primitive.ObjectID
        + ProjectId primitive.ObjectID
        + Username string
        + Role string
        + CustomRole string

        + WithTimezone()

    }
    class "Organisation" << (S,Aquamarine) >> {
        + Id primitive.ObjectID
        + Name string
        + Slug string
        + Description string
        + Domain string
        + OwnerId primitive.ObjectID
        + Settings OrganisationSettings
        + IsActive bool
        + Company CompanyDetails
        + Subscription Subscription
        + BillingAddress Address
        + Audit Audit

        + IsOwner(userId primitive.ObjectID) bool

    }
    class "Project" << (S,Aquamarine) >> {
        + Id primitive.ObjectID
        + OrganisationId primitive.ObjectID
        + Name string
        + Slug string
        + Description string
        + IsActive bool
        + PublicKey string
        + PrivateKey string
        + LegacyPublicKey string
        + LegacyPrivateKey string
        + EncryptionKey string
        + HasPincode bool
        + Days []string
        + Audit Audit

    }
    class "OrganisationUser" << (S,Aquamarine) >> {
        + Id primitive.ObjectID
        + UserId primitive.ObjectID
        + OrganisationId primitive.ObjectID
        + Status MembershipStatus
        + InvitedBy primitive.ObjectID
        + InvitedAt time.Time
        + JoinedAt time.Time
        + ExpiresAt time.Time
        + Audit Audit

        + IsExpired() bool
        + IsEffectivelyActive() bool

    }
    class "Role" << (S,Aquamarine) >> {
        + Id primitive.ObjectID
        + OrganisationId primitive.ObjectID
        + Name string
        + Description string
        + Kind RoleKind
        + Key RoleKey
        + AssignableAt PermissionScope
        + Permissions []Permission
        + Origin *RoleOrigin
        + IsActive bool
        + Audit Audit

        + ValidatePermissions() error
        + Validate() error
        + RequiresAllProjects() bool

    }
    class "RoleAssignment" << (S,Aquamarine) >> {
        + Id primitive.ObjectID
        + OrganisationId primitive.ObjectID
        + Principal Principal
        + RoleId primitive.ObjectID
        + Scope RoleAssignmentScope
        + TimeWindow *TimeWindow
        + Source AssignmentSource
        + ExpiresAt time.Time
        + IsActive bool
        + Audit Audit

        + IsExpired() bool
        + IsEffectivelyActive() bool
        + Validate(role Role) error

    }
    class "Principal" << (S,Aquamarine) >> {
        + Type PrincipalType
        + Id primitive.ObjectID

    }
    class "RoleAssignmentScope" << (S,Aquamarine) >> {
        + Level PermissionScope
        + Projects ScopeSelection
        + ProjectIds []primitive.ObjectID
        + ProjectId primitive.ObjectID
        + Resources ScopeSelection
        + SiteIds []primitive.ObjectID
        + GroupIds []primitive.ObjectID
        + DeviceIds []primitive.ObjectID

        + Validate() error
        + ValidateFor(role Role) error

    }
    class "TimeWindow" << (S,Aquamarine) >> {
        + Timezone string
        + Ranges []TimeWindowRange

        + Validate() error
        + Allows(at time.Time) (bool, error)

    }
    class "TimeWindowRange" << (S,Aquamarine) >> {
        + Days []Weekday
        + StartMinute int
        + EndMinute int

    }
    class "OrganisationInvitation" << (S,Aquamarine) >> {
        + Id primitive.ObjectID
        + OrganisationId primitive.ObjectID
        + Email string
        + Assignments []InvitationAssignment
        + Token string
        + TokenHash string
        + InvitedBy primitive.ObjectID
        + Status InvitationStatus
        + ExpiresAt time.Time
        + Audit Audit

    }
    class "InvitationAssignment" << (S,Aquamarine) >> {
        + RoleId primitive.ObjectID
        + Scope RoleAssignmentScope
        + TimeWindow *TimeWindow
        + ExpiresAt time.Time

    }
}
' Relationships below are explicit domain references, not inferred by GoPlantUML.
models.User "1" <-- "0..*" models.Organisation : OwnerId (single owner)
models.Organisation "1" <-- "1..*" models.Project : OrganisationId
models.User "1" <-- "0..*" models.OrganisationUser : UserId
models.Organisation "1" <-- "0..*" models.OrganisationUser : OrganisationId
models.Organisation "1" <-- "0..*" models.Role : OrganisationId
models.Organisation "1" <-- "0..*" models.RoleAssignment : OrganisationId
models.Role "1" <-- "0..*" models.RoleAssignment : RoleId
models.RoleAssignment *-- models.Principal : Principal
models.Principal ..> models.User : Id (type user)
models.RoleAssignment *-- models.RoleAssignmentScope : Scope
models.RoleAssignment *-- "0..1" models.TimeWindow : TimeWindow
models.TimeWindow *-- "1..*" models.TimeWindowRange : Ranges
models.Organisation "1" <-- "0..*" models.OrganisationInvitation : OrganisationId
models.OrganisationInvitation *-- "0..*" models.InvitationAssignment : Assignments
models.Role "1" <-- "0..*" models.InvitationAssignment : RoleId
models.InvitationAssignment *-- models.RoleAssignmentScope : Scope
models.InvitationAssignment *-- "0..1" models.TimeWindow : TimeWindow
models.RoleAssignmentScope ..> models.Project : ProjectId / ProjectIds
@enduml
